{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aieyra Mod manifest v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "name",
    "summary",
    "version",
    "publisher",
    "license",
    "contracts",
    "clients",
    "platforms",
    "entrypoints",
    "data",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aieyra.mod/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,63})+$"
    },
    "kind": {
      "enum": [
        "theme",
        "tool",
        "toolbox",
        "workbox",
        "program",
        "agent",
        "api",
        "context",
        "halo"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "contracts": {
      "type": "object",
      "required": [
        "core"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "enum": [
          "desktop",
          "cli",
          "mobile"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(any|(windows|linux|darwin|android|ios)/(amd64|arm64))$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "capability",
          "scope",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "contract",
          "renderer"
        ],
        "additionalProperties": false,
        "properties": {
          "contract": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "renderer": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "schema",
        "uninstall"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "uninstall": {
          "const": "retain"
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2048,
      "additionalProperties": {
        "type": "object",
        "required": [
          "sha256",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "public_key",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "public_key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
