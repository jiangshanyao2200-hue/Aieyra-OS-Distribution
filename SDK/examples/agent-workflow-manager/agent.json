{
  "schema": 1,
  "id": "example.workflow-manager",
  "version": "1.0.0",
  "name": "工作流专员",
  "tool_choices": [
    "software_api"
  ],
  "default_tools": [
    "software_api"
  ],
  "prompts": {
    "identity": "prompts/identity.txt"
  },
  "context_provider": {
    "id": "aieyra.context.structured",
    "version": "1.0.0",
    "state_schema": 1
  },
  "runtime": {
    "model": {
      "tool_calls": true,
      "image_input": false,
      "min_context_tokens": 0
    },
    "budget": {
      "max_tokens": 100000,
      "timeout_seconds": 300
    },
    "policy": {
      "work_mode": "direct-or-delegate",
      "lifetime": "retained"
    },
    "prompt_order": [
      "identity"
    ],
    "tool_packages": [],
    "programs": [],
    "data_schema": 1,
    "workflow_port": "aieyra.workbox/1"
  }
}
