<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aieyra OS 安装器" Width="650" Height="676" MinWidth="480" MinHeight="450"
        WindowStyle="None" ResizeMode="CanResize" Background="#0C0D0E"
        Foreground="#F0F3F1" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="9"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F2F5F5"/>
    <SolidColorBrush x:Key="Muted" Color="#AAB8BB"/>
    <SolidColorBrush x:Key="Accent" Color="#C9ECEC"/>
    <Style x:Key="SetupButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#171B1D"/>
      <Setter Property="BorderBrush" Value="#343F42"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="#F1FFF9"/>
                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.76"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.44"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SetupButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#112825"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="142"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#101314"/>
      <Setter Property="BorderBrush" Value="#354145"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
      <Setter Property="SelectionBrush" Value="#509685"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="MaxHeight" Value="82"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Input" Background="{TemplateBinding Background}" CornerRadius="7"
                    BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            VerticalAlignment="Center" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
              <Border x:Name="CheckFace" Width="17" Height="17" CornerRadius="4"
                      BorderThickness="1" BorderBrush="#596967" Background="#172022" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 3,7 L 6,10 L 12,4" Stroke="#112825" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckFace" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckFace" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="CheckFace" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CheckFace" Property="BorderBrush" Value="#F1FFF9"/>
                <Setter TargetName="CheckFace" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2,3,2">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#596967" CornerRadius="3"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderThickness="1" BorderBrush="#333B3E">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="68"/>
      </Grid.RowDefinitions>
      <Grid>
        <StackPanel Margin="19,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="BrandMark" Width="18" Height="18" Stretch="Uniform"/>
          <Grid Margin="9,0,0,0">
            <TextBlock x:Name="BrandTitle" Text="Aieyra OS" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False">
        <StackPanel x:Name="InstallerContent" Margin="28,2,28,16" MaxWidth="510">
          <StackPanel.RenderTransform>
            <TranslateTransform/>
          </StackPanel.RenderTransform>
          <Grid x:Name="HaloHost" Width="232" Height="232" HorizontalAlignment="Center">
            <TextBlock x:Name="ProgressValue" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="53" Text="0%" FontWeight="Medium" TextAlignment="Center"/>
          </Grid>
          <Grid Margin="15,6,15,0">
            <StackPanel x:Name="DestinationPage">
              <Grid Margin="0,0,0,13">
                <TextBlock x:Name="DestinationTitle" Text="安装 Aieyra OS" TextAlignment="Center"
                           FontSize="21" FontWeight="SemiBold"/>
              </Grid>
              <Label x:Name="ProgramLabel" Padding="0" Margin="0,0,0,6" Foreground="{StaticResource Ink}"
                     Content="程序位置"/>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProgramPath" AutomationProperties.Name="程序位置"/>
                <Button x:Name="ChooseProgram" Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource SetupButton}"
                        Content="浏览" ToolTip="选择程序目录" AutomationProperties.Name="选择程序目录"/>
              </Grid>
              <Label x:Name="DataLabel" Padding="0" Margin="0,0,0,6" Foreground="{StaticResource Ink}"
                     Content="个人资料位置"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DataPath" AutomationProperties.Name="个人资料位置"/>
                <Button x:Name="ChooseData" Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource SetupButton}"
                        Content="浏览" ToolTip="选择个人资料目录" AutomationProperties.Name="选择个人资料目录"/>
              </Grid>
              <CheckBox x:Name="Shortcuts" Margin="0,15,0,0" IsChecked="True" Content="创建桌面快捷方式组"/>
              <WrapPanel Margin="0,7,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="PrivacyConsent" IsChecked="False" VerticalAlignment="Center" Content="我已阅读并同意" AutomationProperties.Name="我已阅读并同意隐私协议"/>
                <Button x:Name="PrivacyTerms" Content="隐私协议" AutomationProperties.Name="查看隐私协议" Margin="3,0,0,0" Padding="4,0" MinWidth="0" MinHeight="28" Foreground="{StaticResource Accent}" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource SetupButton}"/>
              </WrapPanel>
              <TextBlock x:Name="InputError" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FAC0B5"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <StackPanel x:Name="PrivacyPage" Visibility="Collapsed" MaxWidth="420">
              <Grid><TextBlock x:Name="PrivacyTitle" Text="隐私协议" TextAlignment="Center" FontSize="21" FontWeight="SemiBold"/></Grid>
              <TextBlock Margin="0,16,0,8" TextWrapping="Wrap" LineHeight="22" Text="登录 NEW API 后，中枢会把程序版本和故障类别发到官网众创讨论。同类故障合入一帖，以中枢名义公开。"/>
              <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" LineHeight="22" Text="Eyra 可在执行中提报故障。附加说明会先展示给你，确认后以 Eyra 名义公开。"/>
              <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource Muted}" Text="账号用于验证身份、去重和查回执。可在中枢关闭自动提报，排队的自动报告随即清除。本机反馈记录最多保留 30 天。"/>
              <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Muted}" FontSize="12" Text="生效日期　2026-11-22"/>
            </StackPanel>
            <StackPanel x:Name="ProgressPage" Visibility="Collapsed">
              <Grid>
                <TextBlock x:Name="ProgressLabel" TextAlignment="Center" FontSize="21" FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Polite"/>
              </Grid>
              <Grid Margin="0,12,0,0" MinHeight="22">
                <TextBlock x:Name="ProgressDetails" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}"/>
              </Grid>
            </StackPanel>
            <StackPanel x:Name="CompletePage" Visibility="Collapsed" HorizontalAlignment="Center">
              <Grid>
                <TextBlock x:Name="CompleteTitle" Text="安装完成" TextAlignment="Center"
                           FontSize="21" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
              </Grid>
              <Grid Margin="0,10,0,0">
                <TextBlock x:Name="CompleteDetails" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              </Grid>
              <TextBlock x:Name="CompleteLocation" TextAlignment="Center" Foreground="{StaticResource Muted}"
                         Margin="0,8,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="CompleteNotice" TextAlignment="Center" Foreground="#FAC0B5" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Margin="24,0,24,0" BorderBrush="#22292B" BorderThickness="0,1,0,0">
        <Grid>
          <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="Edition" Foreground="{StaticResource Muted}" FontSize="11"/>
          </Grid>
          <Button x:Name="Action" IsDefault="True" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                  VerticalAlignment="Center" Content="开始安装"/>
          <Button x:Name="ExitSetup" Style="{StaticResource SetupButton}" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent" Content="退出"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
