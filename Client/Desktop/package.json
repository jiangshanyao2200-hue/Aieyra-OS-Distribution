{
  "name": "aieyra-config",
  "productName": "Aieyra Config",
  "version": "0.2.85",
  "private": true,
  "description": "Aieyra OS 的配置中心：与对话程序共用同一份 config.json",
  "license": "MIT",
  "author": "Aieyra",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "ensure": "node tools/ensure-electron.cjs",
    "selftest": "node tools/check.cjs test",
    "syntax": "node tools/check.cjs syntax",
    "typecheck": "node tools/check.cjs syntax",
    "config_path": "node tools/print-paths.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "8.1.3"
  },
  "dependencies": {
    "socks": "2.8.7",
    "ssh2": "^1.17.0"
  }
}
